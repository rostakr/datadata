{
  "name": "datadata",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt && python -m pytest -q",
  "postStartCommand": "nohup python -m streamlit run app.py --server.address 0.0.0.0 --server.port 8501 > /tmp/datadata-streamlit.log 2>&1 &",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "datadata Streamlit",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  }
}
