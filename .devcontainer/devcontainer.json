{
  "name": "datadata",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "make setup-dev && make check && make a6-smoke",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "datadata Streamlit",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1",
    "STREAMLIT_BROWSER_GATHER_USAGE_STATS": "false"
  }
}
